<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 9 F10: Android 12+ (API 31+) reads backup / device-to-device
    transfer policy from dataExtractionRules instead of allowBackup. The
    "cookies never leave the device" guarantee is now pinned EXPLICITLY for
    every domain on both channels: nothing is extractable to cloud backup
    and nothing is transferred during a device-to-device migration.
    allowBackup=false + fullBackupContent=false stay in the manifest for
    API < 31.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
